#!/usr/bin/env bash
set -e

# Suppress Ruby warnings (bundler/rubygems constant redefinition)
export RUBYOPT="-W0"

echo "🔍 Running code quality checks..."

echo "1️⃣  Scan Ruby..."
if ! bin/brakeman --no-pager; then
  echo "❌ Brakeman failed. Please fix the issues above."
  exit 1
fi

echo "2️⃣  Lint Tests..."
if ! bin/rubocop; then
  echo "❌ RuboCop failed. Please fix the issues above."
  exit 1
fi

echo "3️⃣  Code block round-trip (editor)..."
if command -v node >/dev/null 2>&1; then
  if ! node script/check_code_block_roundtrip.mjs; then
    echo "❌ Code block round-trip failed. init.js is re-escaping code blocks."
    exit 1
  fi
else
  echo "⚠️  node not found — skipped here, CI's check_js job still runs it."
fi

echo "4️⃣  Tests..."
if ! bin/rails db:test:prepare test test:system; then
  echo "❌ Rails Tests failed. Please fix the failing tests."
  exit 1
fi

echo "✅ All checks passed! Ready to commit."
